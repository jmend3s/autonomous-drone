<?xml version="1.0"?>
<robot name="drone" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="use_sim" default="true" />

    <xacro:if value="$(arg use_sim)">
        <xacro:include filename="$(find drone_description)/urdf/control/drone.gazebo.xacro" />
    </xacro:if>
    <xacro:include filename="$(find drone_description)/urdf/robot/macros.xacro" />

    <link name="base_footprint"/>
    <joint name="base_footprint_to_base_link" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://drone_description/meshes/frame.stl"/>
            </geometry>
            <material name="blue_body">
                <color rgba="0.0 0.2 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.0115" rpy="0 0 0"/>
            <geometry>
                <box size="0.365 0.365 0.0575"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.803"/>
            <inertia ixx="0.00565" ixy="0.000001" ixz="-0.000047"
                    iyy="0.00602" iyz="-0.000002" izz="0.0113"/>
        </inertial>
    </link>

    <link name="landing_gear">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://drone_description/meshes/landing_gear.stl"/>
            </geometry>
            <material name="dark_gray">
                <color rgba="0.15 0.15 0.15 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 -0.065" rpy="0 0 0"/>
            <geometry>
                <box size="0.225 0.225 0.135"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 -0.10" rpy="0 0 0"/>
            <mass value="0.090"/>
            <inertia ixx="0.00016" ixy="0" ixz="0"
                    iyy="0.000641" iyz="0" izz="0.000769"/>
        </inertial>
    </link>

    <joint name="frame_to_landing_gear" type="fixed">
        <parent link="base_link"/>
        <child link="landing_gear"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <xacro:motor_assembly number="1" x="0.1591" y="0.1591"/>
    <xacro:motor_assembly number="2" x="-0.1591" y="0.1591"/>
    <xacro:motor_assembly number="3" x="0.1591" y="-0.1591"/>
    <xacro:motor_assembly number="4" x="-0.1591" y="-0.1591"/>

</robot>